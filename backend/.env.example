# PostgreSQL connection string used by both the Prisma CLI and the runtime adapter.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional. Defaults to development.
NODE_ENV=development

# Optional. Defaults to 4000.
PORT=4000

# Optional. Comma-separated list of allowed origins. CORS stays disabled when unset.
CORS_ORIGINS=http://localhost:3002

# Required. At least 32 characters each. Use a distinct random value per secret.
JWT_ACCESS_SECRET="replace-with-a-32-plus-character-random-string"
JWT_REFRESH_SECRET="replace-with-a-32-plus-character-random-string"

# Optional. Any span accepted by the `ms` package, e.g. "15m", "7d", "3600s".
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
